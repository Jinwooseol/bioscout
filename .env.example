# Copy to .env and fill in. .env is git-ignored.

# NCBI E-utilities: an API key raises the limit from 3 to 10 requests/s.
# Get one at https://account.ncbi.nlm.nih.gov/settings/ (API Key Management).
NCBI_API_KEY=
NCBI_EMAIL=

# Claude API, used by the eval harness and the agent. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Same model and effort for every variant, so differences come from the design, not the model.
# BIOSCOUT_MODEL=claude-opus-5-5
# BIOSCOUT_EFFORT=medium

# Response cache (SQLite) for API and LLM responses. Default: ~/.cache/bioscout
# BIOSCOUT_CACHE_DIR=
# readwrite (default) | readonly (replay only, for CI and reproducible evals) | off
# BIOSCOUT_CACHE_MODE=readwrite
# BIOSCOUT_CACHE_TTL_DAYS=30

# Tracing (optional; install with `uv sync --extra trace`). With both keys set, every answer's steps,
# model calls and PubMed calls are sent to Langfuse. https://cloud.langfuse.com -> project settings -> API keys
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# EU cloud by default; US: https://us.cloud.langfuse.com, self-hosted: your own address
# LANGFUSE_HOST=https://cloud.langfuse.com
# off: send names, counts, tokens and cost only, no questions, prompts or replies
# BIOSCOUT_TRACE_CONTENT=on

# The cap on questions answered with ANTHROPIC_API_KEY through the demo page or the HTTP API, for all
# visitors together. It is counted in a SQLite file, so a restart does not reset it. 0 closes it.
# BIOSCOUT_MAX_QUESTIONS_PER_DAY=20
# BIOSCOUT_MAX_QUESTIONS_TOTAL=200
# Of the day's questions, how many one caller of the API may ask (callers are told apart by address)
# BIOSCOUT_MAX_QUESTIONS_PER_CALLER=5
# Default: quota.sqlite in the cache directory
# BIOSCOUT_QUOTA_PATH=

# In the container only: what the image serves when it is given no command. page (default) or api
# BIOSCOUT_SERVE=page

# HTTP API (optional; `uv run --extra api bioscout-api`)
# BIOSCOUT_API_HOST=127.0.0.1
# BIOSCOUT_API_PORT=8000
# Answers that may run at the same time, and how long one may take (seconds)
# BIOSCOUT_API_MAX_CONCURRENT=2
# BIOSCOUT_API_TIMEOUT_S=300
# Behind a proxy: the request header in which the proxy gives the caller's address, for the limit
# per caller. Only a header the proxy sets itself (Fly-Client-IP on Fly.io), never X-Forwarded-For.
# Default: the address the connection comes from
# BIOSCOUT_API_CLIENT_HEADER=
# Web pages on other origins that may call the API, comma-separated. Default: none
# BIOSCOUT_API_CORS_ORIGINS=https://brakey-bioscout.static.hf.space
