# Copy to .env and fill in. .env is git-ignored.

# NCBI E-utilities: an API key raises the limit from 3 to 10 requests/s.
# Get one at https://account.ncbi.nlm.nih.gov/settings/ (API Key Management).
NCBI_API_KEY=
NCBI_EMAIL=

# Response cache (SQLite). Default: ~/.cache/bioscout
# BIOSCOUT_CACHE_DIR=
# readwrite (default) | readonly (replay only, for CI and reproducible evals) | off
# BIOSCOUT_CACHE_MODE=readwrite
# BIOSCOUT_CACHE_TTL_DAYS=30
