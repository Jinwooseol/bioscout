# Copy to .env and fill in. .env is git-ignored.

# NCBI E-utilities: an API key raises the limit from 3 to 10 requests/s.
# Get one at https://account.ncbi.nlm.nih.gov/settings/ (API Key Management).
NCBI_API_KEY=
NCBI_EMAIL=

# Claude API, used by the eval harness and (from Day 3) the agent. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Same model and effort for every variant, so differences come from the design, not the model.
# BIOSCOUT_MODEL=claude-opus-5-5
# BIOSCOUT_EFFORT=medium

# Response cache (SQLite) for API and LLM responses. Default: ~/.cache/bioscout
# BIOSCOUT_CACHE_DIR=
# readwrite (default) | readonly (replay only, for CI and reproducible evals) | off
# BIOSCOUT_CACHE_MODE=readwrite
# BIOSCOUT_CACHE_TTL_DAYS=30
